@{
    ViewData["Title"] = "Secure web file manager";
}
<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">YOUR FILES. ANYWHERE.</span>
        <h1>Rise above your<br /><span>remote files.</span></h1>
        <p>Connect securely to FTP and FTPS servers, then manage every file from one fast, responsive workspace.</p>
        <div class="hero-actions">
            <a class="button button-primary button-large" asp-area="Identity" asp-page="/Account/Register">Create free account <span>→</span></a>
            <a class="button button-ghost button-large" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
        </div>
        <div class="trust-row"><span>✓ Encrypted credentials</span><span>✓ FTP &amp; FTPS</span><span>✓ Mobile ready</span></div>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="sun-ring"></div>
        <div class="eagle-wings"><span>‹</span><b>E</b><span>›</span></div>
        <div class="floating-card card-one"><i>▱</i><div><b>Project files</b><small>24 items</small></div></div>
        <div class="floating-card card-two"><i>✓</i><div><b>Transfer complete</b><small>12.8 MB uploaded</small></div></div>
    </div>
</section>
