@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="page-heading" style="align-items: flex-start;">
    <div>
        <span class="eyebrow danger">REQUEST FAILED</span>
        <h1>Something went wrong</h1>
        <p>EagleFiles could not complete this request. The error was written to the application log together with this request ID.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
    </div>
    <div class="form-actions">
        <a class="button button-soft" asp-controller="Home" asp-action="Index">Back to EagleFiles</a>
    </div>
</section>
