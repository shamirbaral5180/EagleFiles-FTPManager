{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/eaglefiles.db;Cache=Shared"
  },
  "Media": {
    "ThumbnailCachePath": "ThumbnailCache",
    "FfmpegPath": "ffmpeg",
    "ThumbnailQuality": 75,
    "PreviewQuality": 100,
    "MaxConcurrentGenerators": 8
  },
  "Storage": {
    "DataPath": "App_Data"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
