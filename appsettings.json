{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/eaglefiles.db;Cache=Shared"
  },
  "Media": {
    "ThumbnailCachePath": "App_Data/ThumbnailCache",
    "FfmpegPath": "ffmpeg",
    "ThumbnailQuality": 78,
    "PreviewQuality": 100,
    "MaxConcurrentGenerators": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
